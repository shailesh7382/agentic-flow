{
  "path": "/api/v1/incidents/search",
  "query": {},
  "headers": {
    "Accept": "application/json",
    "Content-Type": "application/json"
  },
  "header_env": {
    "Authorization": "DIAGNOSTICS_INCIDENT_API_AUTHORIZATION"
  },
  "body": {
    "service": "{{service}}",
    "environment": "{{environment}}",
    "from": "{{from_timestamp}}",
    "to": "{{to_timestamp}}",
    "limit": "{{limit}}"
  },
  "variables": {
    "service": {
      "type": "string",
      "description": "Service name to investigate.",
      "required": true,
      "min_length": 2,
      "max_length": 100
    },
    "environment": {
      "type": "string",
      "description": "Deployment environment.",
      "required": true,
      "enum": ["development", "staging", "production"]
    },
    "from_timestamp": {
      "type": "string",
      "description": "Inclusive ISO-8601 start timestamp.",
      "required": true,
      "max_length": 40
    },
    "to_timestamp": {
      "type": "string",
      "description": "Exclusive ISO-8601 end timestamp.",
      "required": true,
      "max_length": 40
    },
    "limit": {
      "type": "integer",
      "description": "Maximum incidents returned by the upstream service.",
      "required": false,
      "default": 50,
      "minimum": 1,
      "maximum": 200
    }
  }
}
