LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=
AGENT_TEMPERATURE=0.35
AGENT_MAX_TOKENS=1800
AGENT_MAX_REVISIONS=1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Diagnostics agent
DIAGNOSTICS_ENABLED=true
DIAGNOSTICS_MAX_ITERATIONS=8
DIAGNOSTICS_MAX_CONFIGURED_TOOLS=64
DIAGNOSTICS_TOOL_TIMEOUT_SECONDS=30

# REST diagnostic tool: exact hosts or *.example.com, comma-separated
DIAGNOSTICS_REST_ALLOWED_HOSTS=localhost,127.0.0.1
DIAGNOSTICS_REST_MAX_RESPONSE_BYTES=1048576
DIAGNOSTICS_REST_HEADERS_JSON={}
DIAGNOSTICS_REST_TOOLS_CSV=config/rest-tools.csv
DIAGNOSTICS_REST_TEMPLATE_ROOT=config/rest-templates

# Oracle diagnostic tool: disabled until all three connection values are set.
# Always use a database account with SELECT-only privileges.
ORACLE_DSN=
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_MAX_ROWS=200

# Unix tools: local paths are relative to backend/ unless absolute.
DIAGNOSTICS_LOCAL_LOG_ROOTS=logs,/var/log
DIAGNOSTICS_MAX_LOG_BYTES=2097152

# Optional SSH aliases. Never expose arbitrary hostnames to the model.
# Example:
# DIAGNOSTICS_UNIX_HOSTS_JSON={"prod-app":{"host":"app01.internal","port":22,"username":"diagnostics","client_keys":["/run/secrets/diag_key"],"known_hosts":"/etc/ssh/ssh_known_hosts","log_roots":["/var/log/myapp"]}}
DIAGNOSTICS_UNIX_HOSTS_JSON={}
DIAGNOSTICS_UNIX_HOSTS_CSV=config/unix-hosts.csv
DIAGNOSTICS_LOG_DOWNLOAD_DIR=logs/collected
DIAGNOSTICS_SCP_MAX_BYTES=10485760

LOG_LEVEL=DEBUG
LOG_FILE=logs/agentic-flow.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_INCLUDE_CONTENT=true
